# Space365 client env (all optional — defaults target local dev).
# Copy to .env.local to override; never commit real secrets (none are needed:
# this is a public SPA client — no client secret exists for SPA auth).

# SpacetimeDB
VITE_STDB_URI=ws://127.0.0.1:3000
VITE_STDB_DB=space365

# Microsoft Entra app registration (SPA / PKCE popup auth)
VITE_ENTRA_CLIENT_ID=c0c22d69-599d-4e47-8e42-502033f70996
VITE_ENTRA_TENANT_ID=ddd9f933-04a5-43f0-8673-5933da46cdcb
