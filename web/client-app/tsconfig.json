{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@bindings": ["../../shared/bindings/index.ts"],
      "@bindings/*": ["../../shared/bindings/*"],
      "@shared/*": ["../../shared/types/*"],
      "spacetimedb": ["./node_modules/spacetimedb"]
    }
  },
  "include": ["src", "vite.config.ts", "../../shared/bindings", "../../shared/types/layout.ts"]
}
